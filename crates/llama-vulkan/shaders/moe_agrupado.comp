shared uint grade[256];
shared uint slot_de[MAXC];
shared uint xcol_de[MAXC];

uint byte_de(uvec4 v, uint i) {
    uint w = i < 4u ? v.x : (i < 8u ? v.y : (i < 12u ? v.z : v.w));
    return (w >> (8u * (i & 3u))) & 0xFFu;
}

uint palavra(uvec4 v, uint i) {
    return i == 0u ? v.x : (i == 1u ? v.y : (i == 2u ? v.z : v.w));
}

// Q5_K (TIPO 2) e Q6_K (TIPO 3) usam os layouts do upload: o Q5_K cru, 176 B = 11 uvec4; o
// Q6_K em 212 B (53 uints, ver `pad_q6_k_into`), que não fecha em uvec4 — daí esta visão
// em uint do mesmo binding.
layout(set = 0, binding = 0) readonly buffer WeightU { uint w[]; } weight_u;

// v em 0..63 por byte vira v - 32 em int8, sem empréstimo entre bytes.
uint menos32(uint v) {
    return ((v | 0x80808080u) - 0x20202020u) ^ 0x80808080u;
}

// Escala e mínimo de 6 bits do sub-bloco `j` do Q5_K; `scales[i]` é o byte 4 + i de `hdr`.
void escala_min_q5(uvec4 hdr, uint j, out uint sc, out uint m) {
    if (j < 4u) {
        sc = byte_de(hdr, 4u + j) & 63u;
        m = byte_de(hdr, 8u + j) & 63u;
    } else {
        uint a = byte_de(hdr, 8u + j);
        sc = (a & 0xFu) | ((byte_de(hdr, j) >> 6u) << 4u);
        m = (a >> 4u) | ((byte_de(hdr, 4u + j) >> 6u) << 4u);
    }
}

// Q5_K e Q6_K: os 32 int8 do sub-bloco `j` do superbloco `isb` (índice global,
// `(expert * n_out + linha) * n_sb + sb`) e as escalas das metades de 16. O sub-bloco vale
// `s0 * dot(w[0..4], xa) + s1 * dot(w[4..8], xb) - mn * soma(x)`; `mn` só não é zero no Q5_K.
// Mesma ordem de elementos de `q5_k_matvec.comp` e `q6_k_matvec.comp`.
void desempacotar_k(uint isb, uint j, out int w[8], out float s0, out float s1, out float mn) {
    if (TIPO == 2u) {
        uint b4 = isb * 11u;
        uvec4 hdr = weight_buf.w4[b4];
        vec2 dm = unpackHalf2x16(hdr.x);
        uint sc;
        uint m;
        escala_min_q5(hdr, j, sc, m);
        uvec4 qh0 = weight_buf.w4[b4 + 1u];
        uvec4 qh1 = weight_buf.w4[b4 + 2u];
        uvec4 qs0 = weight_buf.w4[b4 + 3u + (j >> 1u) * 2u];
        uvec4 qs1 = weight_buf.w4[b4 + 4u + (j >> 1u) * 2u];
        uint sh = 4u * (j & 1u);
        for (uint k = 0u; k < 4u; k++) {
            w[k] = int(((palavra(qs0, k) >> sh) & 0x0F0F0F0Fu)
                       | (((palavra(qh0, k) >> j) & 0x01010101u) << 4u));
            w[k + 4u] = int(((palavra(qs1, k) >> sh) & 0x0F0F0F0Fu)
                            | (((palavra(qh1, k) >> j) & 0x01010101u) << 4u));
        }
        s0 = dm.x * float(sc);
        s1 = s0;
        mn = dm.y * float(m);
    } else {
        // Metade de 128 elementos `j / 4`, quarto `j % 4`: ql escolhe o nibble, qh o par
        // de bits — o laço `l`, `l + 32`, `l + 64`, `l + 96` do ggml.
        uint bu = isb * 53u;
        uint quarto = j & 3u;
        uint ql = bu + (j >> 2u) * 16u + (quarto & 1u) * 8u;
        uint qh = bu + 32u + (j >> 2u) * 8u;
        uint sh_l = quarto >= 2u ? 4u : 0u;
        for (uint k = 0u; k < 8u; k++) {
            uint v = ((weight_u.w[ql + k] >> sh_l) & 0x0F0F0F0Fu)
                   | (((weight_u.w[qh + k] >> (2u * quarto)) & 0x03030303u) << 4u);
            w[k] = int(menos32(v));
        }
        float d = unpackHalf2x16(weight_u.w[bu + 52u]).x;
        // scales[2j] e scales[2j + 1], i8, nos bytes 192 + 2j.
        uint esc = weight_u.w[bu + 48u + (j >> 1u)];
        uint o = 16u * (j & 1u);
        s0 = d * float(int(esc << (24u - o)) >> 24);
        s1 = d * float(int(esc << (16u - o)) >> 24);
        mn = 0.0;
    }
}

int escala_q3(uvec4 sc, uint is) {
    uint lo = is < 8u ? (byte_de(sc, is) & 0xFu) : (byte_de(sc, is - 8u) >> 4u);
    uint hi = (byte_de(sc, 8u + (is & 3u)) >> (2u * (is >> 2u))) & 3u;
    return int(lo | (hi << 4u)) - 32;
}

// u em 0..7 por byte vira u - 4 em int8, sem empréstimo entre bytes.
uint menos4(uint v) {
    return ((v | 0x80808080u) - 0x04040404u) ^ 0x80808080u;
}

uint mascara_neg(uint nib) {
    return ((nib * 0x00204081u) & 0x01010101u) * 0xFFu;
}

// Os 32 valores int8 com sinal do sub-bloco `j` de um superbloco e as escalas das metades.
void desempacotar(uint b4, uint j, out int w[8], out float s0, out float s1) {
    if (TIPO == 0u) {
        uint n = j >> 2u;
        uint sh_q = 2u * (j & 3u);
        uvec4 h0 = weight_buf.w4[b4];
        uvec4 h1 = weight_buf.w4[b4 + 1u];
        uvec4 q0 = weight_buf.w4[b4 + 2u + 2u * n];
        uvec4 q1 = weight_buf.w4[b4 + 3u + 2u * n];
        uvec4 sc = weight_buf.w4[b4 + 6u];
        for (uint k = 0u; k < 4u; k++) {
            uint qa = palavra(q0, k);
            uint qb = palavra(q1, k);
            uint ha = palavra(h0, k);
            uint hb = palavra(h1, k);
            w[k] = int(menos4(((qa >> sh_q) & 0x03030303u) | (((ha >> j) & 0x01010101u) << 2u)));
            w[k + 4u] = int(menos4(((qb >> sh_q) & 0x03030303u) | (((hb >> j) & 0x01010101u) << 2u)));
        }
        float d = unpackHalf2x16(sc.w).x;
        s0 = d * float(escala_q3(sc, 2u * j));
        s1 = d * float(escala_q3(sc, 2u * j + 1u));
    } else {
        uvec4 qv = weight_buf.w4[b4 + (j >> 1u)];
        uint qw0 = palavra(qv, (j & 1u) * 2u);
        uint qw1 = palavra(qv, (j & 1u) * 2u + 1u);
        uint aux = palavra(weight_buf.w4[b4 + 4u + (j >> 2u)], j & 3u);
        float d = unpackHalf2x16(weight_buf.w4[b4 + 6u].x).x;
        s0 = d * (0.5 + float(aux >> 28u)) * 0.5;
        s1 = s0;
        for (uint l = 0u; l < 4u; l++) {
            uint s7 = (aux >> (7u * l)) & 127u;
            uint sinais = s7 | ((bitCount(s7) & 1u) << 7u);
            uint qw = l < 2u ? qw0 : qw1;
            uint g1 = grade[(qw >> (16u * (l & 1u))) & 0xFFu];
            uint g2 = grade[(qw >> (16u * (l & 1u) + 8u)) & 0xFFu];
            uint m1 = mascara_neg(sinais & 0xFu);
            uint m2 = mascara_neg(sinais >> 4u);
            // A grade não tem zero, então negar byte a byte (xor + 1) não carrega.
            w[2u * l] = int((g1 ^ m1) + (m1 & 0x01010101u));
            w[2u * l + 1u] = int((g2 ^ m2) + (m2 & 0x01010101u));
        }
    }
}

void main() {
    uint tid = gl_LocalInvocationIndex;
    if (TIPO == 1u) {
        grade[tid] = IQ3XXS_GRID[tid];
    }
    uint tile = gl_WorkGroupID.y;
    if (tile >= mapa.m[0]) { return; }
    uint d = 2u + 3u * tile;
    uint expert = mapa.m[d];
    uint inicio = mapa.m[d + 1u];
    uint n_cols = mapa.m[d + 2u];
    if (tid < MAXC) {
        uint s = mapa.m[mapa.m[1] + inicio + min(tid, n_cols - 1u)];
        slot_de[tid] = s;
        xcol_de[tid] = pc.x_por_slot != 0u ? s : s / pc.n_usados;
    }
    barrier();

    // Uma linha por lane: a lane percorre a linha inteira, e as colunas acumulam em
    // registrador — sem redução entre lanes. A ativação é a mesma para as 64 lanes de uma
    // wave (mesmo endereço), então o L1 a serve em broadcast.
    uint row = gl_WorkGroupID.x * 256u + tid;
    if (row >= pc.n_out) { return; }
    uint n_sb = pc.n_in / 256u;
    uint linha4 = n_sb * UVEC4_PER_SB;
    uint n_blk = pc.n_in / 32u;
    uint b_linha = (expert * pc.n_out + row) * linha4;

    float acc[MAXC];
    for (uint c = 0u; c < MAXC; c++) { acc[c] = 0.0; }

    for (uint sb = 0u; sb < n_sb; sb++) {
        uint b4 = b_linha + sb * UVEC4_PER_SB;
        for (uint j = 0u; j < 8u; j++) {
            int w[8];
            float s0;
            float s1;
            float mn = 0.0;
            if (TIPO >= 2u) {
                desempacotar_k((expert * pc.n_out + row) * n_sb + sb, j, w, s0, s1, mn);
            } else {
                desempacotar(b4, j, w, s0, s1);
            }
            uint blk = sb * 8u + j;
            for (uint c = 0u; c < MAXC; c++) {
                if (c >= n_cols) { break; }
                uint cb = xcol_de[c] * n_blk + blk;
                ivec4 xa = xq_buf.xq4[cb * 2u];
                ivec4 xb = xq_buf.xq4[cb * 2u + 1u];
                int d0 = 0;
                d0 = dotPacked4x8AccSatEXT(w[0], xa.x, d0);
                d0 = dotPacked4x8AccSatEXT(w[1], xa.y, d0);
                d0 = dotPacked4x8AccSatEXT(w[2], xa.z, d0);
                d0 = dotPacked4x8AccSatEXT(w[3], xa.w, d0);
                int d1 = 0;
                d1 = dotPacked4x8AccSatEXT(w[4], xb.x, d1);
                d1 = dotPacked4x8AccSatEXT(w[5], xb.y, d1);
                d1 = dotPacked4x8AccSatEXT(w[6], xb.z, d1);
                d1 = dotPacked4x8AccSatEXT(w[7], xb.w, d1);
                float t = s0 * float(d0) + s1 * float(d1);
                if (TIPO == 2u) {
                    int sx = 0;
                    sx = dotPacked4x8AccSatEXT(0x01010101, xa.x, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xa.y, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xa.z, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xa.w, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xb.x, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xb.y, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xb.z, sx);
                    sx = dotPacked4x8AccSatEXT(0x01010101, xb.w, sx);
                    t -= mn * float(sx);
                }
                acc[c] += xd_buf.xd[cb] * t;
            }
        }
    }
    for (uint c = 0u; c < MAXC; c++) {
        if (c >= n_cols) { break; }
        out_buf.y[slot_de[c] * pc.n_out + row] = acc[c];
    }
}
