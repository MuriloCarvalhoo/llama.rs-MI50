#version 450
#extension GL_EXT_integer_dot_product : require

// Matvec dos experts no bloco de prefill, com os slots agrupados por expert: cada
// workgroup em Y é um tile da lista do `moe_contar.comp` (um expert e até MAXC slots que o
// escolheram), e cada linha do peso do expert é lida e desempacotada **uma vez** para todas
// as colunas do tile.
//
// Com o bloco de 256 tokens cada expert recebe ~8 dos 2048 slots.
//
// Uma linha do peso por lane (256 por workgroup): a lane percorre a linha inteira e as
// colunas do tile acumulam em registrador, sem redução entre lanes. Com n_in de 512–2048 e
// ~8 colunas, as reduções do matvec por wave (`moe_matvec.comp`) custavam mais que a conta;
// e o GEMM em LDS carregava tiles de 128 linhas para poucas colunas úteis. Medido no bloco
// de 256 do Qwen3.8-35B-A3B: experts de 141 para 115 ms por bloco nas duas GPUs.
//
// Layouts (Q3_K e IQ3_XXS alinhados em 112 bytes; Q5_K e Q6_K como no upload) iguais aos
// de `moe_matvec.comp`. Por
// sub-bloco de 32, a lane desempacota os valores já com sinal (o Q3_K com o -4 aplicado, o
// IQ3_XXS com o sinal da grade) e as duas escalas de 16; cada coluna é
// `xd * (s0 * dot(w[0..4], xa) + s1 * dot(w[4..8], xb))`.

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TIPO = 0u;   // 0 = Q3_K, 1 = IQ3_XXS, 2 = Q5_K, 3 = Q6_K
const uint UVEC4_PER_SB = 7u;
const uint MAXC = 16u;            // colunas por tile — o `MOE_BN` do host

layout(set = 0, binding = 0) readonly buffer WeightBuf { uvec4 w4[]; } weight_buf;
layout(set = 0, binding = 1) readonly buffer XqBuf { ivec4 xq4[]; } xq_buf;
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;
layout(set = 0, binding = 4) readonly buffer MapaBuf { uint m[]; } mapa;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint n_usados;
    uint x_por_slot;
} pc;

