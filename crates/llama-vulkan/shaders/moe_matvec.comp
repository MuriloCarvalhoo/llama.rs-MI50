shared uint grade[256];

uint byte_de(uvec4 v, uint i) {
    uint w = i < 4u ? v.x : (i < 8u ? v.y : (i < 12u ? v.z : v.w));
    return (w >> (8u * (i & 3u))) & 0xFFu;
}

uint palavra(uvec4 v, uint i) {
    return i == 0u ? v.x : (i == 1u ? v.y : (i == 2u ? v.z : v.w));
}

int escala_q3(uvec4 sc, uint is) {
    uint lo = is < 8u ? (byte_de(sc, is) & 0xFu) : (byte_de(sc, is - 8u) >> 4u);
    uint hi = (byte_de(sc, 8u + (is & 3u)) >> (2u * (is >> 2u))) & 3u;
    return int(lo | (hi << 4u)) - 32;
}

int upack(uint qw, uint hw, uint sh_q, uint sh_h) {
    return int(((qw >> sh_q) & 0x03030303u) | (((hw >> sh_h) & 0x01010101u) << 2u));
}

int dot_meia(uvec4 q, uvec4 h, uint sh_q, uint sh_h, ivec4 x) {
    int s = 0;
    s = dotPacked4x8AccSatEXT(upack(q.x, h.x, sh_q, sh_h), x.x, s);
    s = dotPacked4x8AccSatEXT(upack(q.y, h.y, sh_q, sh_h), x.y, s);
    s = dotPacked4x8AccSatEXT(upack(q.z, h.z, sh_q, sh_h), x.z, s);
    s = dotPacked4x8AccSatEXT(upack(q.w, h.w, sh_q, sh_h), x.w, s);
    return s;
}

int soma4(ivec4 x) {
    int s = 0;
    s = dotPacked4x8AccSatEXT(0x01010101, x.x, s);
    s = dotPacked4x8AccSatEXT(0x01010101, x.y, s);
    s = dotPacked4x8AccSatEXT(0x01010101, x.z, s);
    s = dotPacked4x8AccSatEXT(0x01010101, x.w, s);
    return s;
}

// Bytes de `nib` (4 bits) espalhados: 0xFF onde o bit está ligado.
uint mascara_neg(uint nib) {
    return ((nib * 0x00204081u) & 0x01010101u) * 0xFFu;
}

// dot de 8 elementos de um índice de qs par/ímpar contra duas palavras da ativação.
int dot_iq3(uint qi1, uint qi2, uint sinais, int xa, int xb) {
    uint g1 = grade[qi1];
    uint g2 = grade[qi2];
    uint n1 = g1 & mascara_neg(sinais & 0xFu);
    uint n2 = g2 & mascara_neg(sinais >> 4u);
    int s = 0;
    s = dotPacked4x8AccSatEXT(int(g1), xa, s);
    s = dotPacked4x8AccSatEXT(int(g2), xb, s);
    int neg = 0;
    neg = dotPacked4x8AccSatEXT(int(n1), xa, neg);
    neg = dotPacked4x8AccSatEXT(int(n2), xb, neg);
    return s - 2 * neg;
}

void main() {
    if (TIPO == 1u) {
        grade[gl_LocalInvocationIndex] = IQ3XXS_GRID[gl_LocalInvocationIndex];
        barrier();
    }
    uint lane = gl_SubgroupInvocationID;
    uint row = (gl_WorkGroupID.x * WAVES_PER_WG + gl_SubgroupID) * ROWS_PER_WAVE;
    if (row >= pc.n_out) { return; }

    uint slot = gl_WorkGroupID.y;
    uint expert = ids_buf.ids[slot];
    uint col = pc.x_por_slot != 0u ? slot : slot / pc.n_usados;

    uint n_sb = pc.n_in / 256u;
    uint linha4 = n_sb * UVEC4_PER_SB;
    uint n_blk = pc.n_in / 32u;
    uint base_exp = expert * pc.n_out * linha4;

    uint j = lane & 7u;
    uint sb_in_grp = lane >> 3u;
    uint n = j >> 2u;
    uint sh_q = 2u * (j & 3u);
    uint sh_h = 4u * n + (j & 3u);

    float acc[ROWS_PER_WAVE];
    for (uint r = 0u; r < ROWS_PER_WAVE; r++) { acc[r] = 0.0; }

    for (uint sb0 = 0u; sb0 < n_sb; sb0 += 8u) {
        uint sb = sb0 + sb_in_grp;
        if (sb >= n_sb) { continue; }
        uint cb = col * n_blk + sb * 8u + j;
        ivec4 xa = xq_buf.xq4[cb * 2u];
        ivec4 xb = xq_buf.xq4[cb * 2u + 1u];
        float xdv = xd_buf.xd[cb];

        for (uint r = 0u; r < ROWS_PER_WAVE; r++) {
            if (row + r >= pc.n_out) { continue; }
            uint b4 = base_exp + (row + r) * linha4 + sb * UVEC4_PER_SB;
            if (TIPO == 0u) {
                uvec4 h0 = weight_buf.w4[b4];
                uvec4 h1 = weight_buf.w4[b4 + 1u];
                uvec4 q0 = weight_buf.w4[b4 + 2u + 2u * n];
                uvec4 q1 = weight_buf.w4[b4 + 3u + 2u * n];
                uvec4 sc = weight_buf.w4[b4 + 6u];
                float d = unpackHalf2x16(sc.w).x;
                int d0 = dot_meia(q0, h0, sh_q, sh_h, xa) - 4 * soma4(xa);
                int d1 = dot_meia(q1, h1, sh_q, sh_h, xb) - 4 * soma4(xb);
                acc[r] += xdv * d * (float(escala_q3(sc, 2u * j)) * float(d0)
                                   + float(escala_q3(sc, 2u * j + 1u)) * float(d1));
            } else {
                uvec4 qv = weight_buf.w4[b4 + (j >> 1u)];
                uint qw0 = palavra(qv, (j & 1u) * 2u);
                uint qw1 = palavra(qv, (j & 1u) * 2u + 1u);
                uint aux = palavra(weight_buf.w4[b4 + 4u + (j >> 2u)], j & 3u);
                float d = unpackHalf2x16(weight_buf.w4[b4 + 6u].x).x;
                float db = d * (0.5 + float(aux >> 28u)) * 0.5;
                int s = 0;
                for (uint l = 0u; l < 4u; l++) {
                    uint s7 = (aux >> (7u * l)) & 127u;
                    uint sinais = s7 | ((bitCount(s7) & 1u) << 7u);
                    uint qw = l < 2u ? qw0 : qw1;
                    uint qi1 = (qw >> (16u * (l & 1u))) & 0xFFu;
                    uint qi2 = (qw >> (16u * (l & 1u) + 8u)) & 0xFFu;
                    // elementos 8l..8l+7 = palavras 2l e 2l+1 do bloco de 32 da ativação
                    int x1 = l < 2u ? (l == 0u ? xa.x : xa.z) : (l == 2u ? xb.x : xb.z);
                    int x2 = l < 2u ? (l == 0u ? xa.y : xa.w) : (l == 2u ? xb.y : xb.w);
                    s += dot_iq3(qi1, qi2, sinais, x1, x2);
                }
                acc[r] += xdv * db * float(s);
            }
        }
    }

    for (uint r = 0u; r < ROWS_PER_WAVE; r++) {
        float s = subgroupAdd(acc[r]);
        if (lane == 0u && row + r < pc.n_out) {
            out_buf.y[slot * pc.n_out + row + r] = s;
        }
    }
}
