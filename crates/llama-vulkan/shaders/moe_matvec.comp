#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_integer_dot_product : require

// Matvec dos experts de um MoE: cada slot (token, k) multiplica a ativação pela matriz do
// expert que o top-k escolheu para ele.
//
//   y[s * n_out + linha] = W[ids[s]][linha, :] · x[col(s), :]
//
// `ids` vem do `moe_topk.comp` e é lido aqui, na GPU — o host nunca vê qual expert foi
// escolhido. O grid Y é o slot (n_tok * n_usados); o X particiona as linhas, como no matvec
// denso. `col(s)` é `s / n_usados` no gate/up (os 8 experts do token leem a mesma entrada) e
// `s` no down (cada slot tem a sua, saída do SwiGLU do próprio expert).
//
// O peso é o tensor 3D inteiro, `[n_expert][n_out][n_in]`, com os blocos alinhados em 112
// bytes (7 uvec4) nos dois tipos:
//
// - TIPO 0, Q3_K: o mesmo layout e a mesma conta do `q3_k_matvec.comp`.
// - TIPO 1, IQ3_XXS: reempacotado no upload para
//     uvec4 0..3 : qs[64] — índices na grade, 8 por sub-bloco de 32
//     uvec4 4..5 : uma palavra por sub-bloco: escala nos 4 bits altos, 4 índices de sinal de 7
//     uvec4 6    : .x = d (f16) | pad
//   Cada índice de qs aponta 4 magnitudes de 8 bits (≤ 62) em `IQ3XXS_GRID`. O sinal
//   entra sem desempacotar: dot(g ⊙ ±1, x) = dot(g, x) - 2 * dot(g & neg, x), com `neg` com
//   0xFF nos bytes negativos. O 8º bit de sinal é a paridade dos 7 — o `ksigns_iq2xs` do
//   llama.cpp, calculado. Mesma ordem de `dequantize_row_iq3_xxs`.

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TIPO = 0u;
const uint WAVES_PER_WG = 4u;
const uint ROWS_PER_WAVE = 2u;
const uint UVEC4_PER_SB = 7u;

layout(set = 0, binding = 0) readonly buffer WeightBuf { uvec4 w4[]; } weight_buf;
layout(set = 0, binding = 1) readonly buffer XqBuf { ivec4 xq4[]; } xq_buf;
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;
layout(set = 0, binding = 4) readonly buffer IdsBuf { uint ids[]; } ids_buf;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint n_usados;
    uint x_por_slot;   // 1 no down: cada slot tem a sua ativação
} pc;

