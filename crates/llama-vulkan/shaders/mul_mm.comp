// Linha de peso do expert do tile (0 fora do MoE) — somada ao índice de linha nos loads.
uint base_linha = 0u;

// Coluna da ativação para a coluna `c` do tile.
uint coluna(uint col0, uint c) {
    return MOE == 1u ? xcol_de[c] : col0 + c;
}

uint mascara_neg(uint nib) {
    return ((nib * 0x00204081u) & 0x01010101u) * 0xFFu;
}
shared float lxd[BN];
shared float lxs[BN];

// Byte `i` (0..11) de scales[], nos bytes 4..15 do superbloco — ver `q4_k_matvec.comp`.
uint scale_byte(uvec4 hdr, uint i) {
    uint word = i < 4u ? hdr.y : (i < 8u ? hdr.z : hdr.w);
    return (word >> (8u * (i & 3u))) & 0xFFu;
}

void scale_min(uvec4 hdr, uint j, out uint sc, out uint m) {
    if (j < 4u) {
        sc = scale_byte(hdr, j) & 63u;
        m  = scale_byte(hdr, j + 4u) & 63u;
    } else {
        uint a = scale_byte(hdr, j + 4u);
        uint b = scale_byte(hdr, j - 4u);
        uint c = scale_byte(hdr, j);
        sc = (a & 0xFu) | ((b >> 6u) << 4u);
        m  = (a >> 4u)  | ((c >> 6u) << 4u);
    }
}

uint wpack(uint qsw, bool hi) {
    return (hi ? (qsw >> 4u) : qsw) & 0x0F0F0F0Fu;
}

// Os loads globais de um passo de K para os registradores da thread: peso (os bytes da
// metade dela no passo, e o que for preciso para a escala), ativação (um uint) e, nas COLS
// primeiras threads, escala e os 8 uints do bloco para a soma do termo do `dmin`.
//
// Q4_K/Q5_K: `hdr` = d|dmin + scales, `qs` = o uvec4 dos nibbles, `qh` = o uvec4 do 5º bit
// (Q5_K). Q6_K: `qs` = 4 uints de `ql`, `qh` = 4 uints de `qh`, `hdr.x` = d, `hdr.y` = o
// uint com a escala i8 do sub-bloco de 16 desta thread.
void buscar(uint k0, uint lg, uint linha4, uint n_blk, bool w_alta, uint x_col, uint x_u,
            uint t, uint col0, inout uvec4 hdr, inout uvec4 qs, inout uvec4 qh, inout int xq,
            inout float xd, inout int xs[8]) {
    uint sb = k0 >> 8u;
    uint j = (k0 >> 5u) & 7u;
    uint blk = k0 >> 5u;
    if (lg < pc.n_out) {
        if (TIPO == Q6K) {
            // `linha4` conta uints aqui. O passo j cobre os sub-blocos de 16 `2j` e `2j+1`;
            // no layout do ggml ficam na metade j/4 do superbloco, no quarto j%4 (ver
            // `q6_k_matvec.comp`), com 16 bytes contíguos de `ql` e de `qh` para cada um.
            uint bu = (base_linha + lg) * linha4 + sb * UINTS_PER_SB_Q6K;
            uint metade = j >> 2u;
            uint quarto = j & 3u;
            uint idx16 = w_alta ? 16u : 0u;
            uint ql_u0 = (metade * 64u + (quarto & 1u) * 32u + idx16) >> 2u;
            uint qh_u0 = (128u + metade * 32u + idx16) >> 2u;
            qs = uvec4(weight_u.w[bu + ql_u0], weight_u.w[bu + ql_u0 + 1u],
                       weight_u.w[bu + ql_u0 + 2u], weight_u.w[bu + ql_u0 + 3u]);
            qh = uvec4(weight_u.w[bu + qh_u0], weight_u.w[bu + qh_u0 + 1u],
                       weight_u.w[bu + qh_u0 + 2u], weight_u.w[bu + qh_u0 + 3u]);
            uint sub = 2u * j + (w_alta ? 1u : 0u);
            hdr.x = weight_u.w[bu + 52u];              // d nos bytes 208..209
            hdr.y = weight_u.w[bu + ((192u + sub) >> 2u)];
        } else if (TIPO == Q80) {
            // Bloco `blk` da linha: 9 uints; a metade desta thread são os uints 1..4 ou 5..8.
            uint bu = (base_linha + lg) * linha4 + blk * 9u;
            uint q0 = bu + 1u + (w_alta ? 4u : 0u);
            qs = uvec4(weight_u.w[q0], weight_u.w[q0 + 1u], weight_u.w[q0 + 2u],
                       weight_u.w[q0 + 3u]);
            hdr.x = weight_u.w[bu];
        } else if (TIPO == Q3K) {
            // Superbloco em 7 uvec4: hmask (0..1), qs (2..5), scales|d (6). A metade de 16
            // desta thread lê a metade correspondente de `hmask` e do pedaço `j/4` de `qs`.
            uint b4 = (base_linha + lg) * linha4 + sb * UVEC4_PER_SB;
            uint h = w_alta ? 1u : 0u;
            qs = weight_buf.w4[b4 + 2u + 2u * (j >> 2u) + h];
            qh = weight_buf.w4[b4 + h];
            hdr = weight_buf.w4[b4 + 6u];
        } else if (TIPO == IQ3) {
            // 7 uvec4: qs (0..3), palavras de escala e sinal (4..5), d (6). A metade de 16
            // desta thread são 4 índices de qs (um uint) e usa a palavra do sub-bloco `j`.
            uint b4 = (base_linha + lg) * linha4 + sb * UVEC4_PER_SB;
            uvec4 qv = weight_buf.w4[b4 + (j >> 1u)];
            uint q = (j & 1u) * 2u + (w_alta ? 1u : 0u);
            qs.x = q == 0u ? qv.x : (q == 1u ? qv.y : (q == 2u ? qv.z : qv.w));
            uvec4 sv = weight_buf.w4[b4 + 4u + (j >> 2u)];
            uint jj = j & 3u;
            hdr.x = jj == 0u ? sv.x : (jj == 1u ? sv.y : (jj == 2u ? sv.z : sv.w));
            hdr.y = weight_buf.w4[b4 + 6u].x;
        } else {
            uint b4 = (base_linha + lg) * linha4 + sb * UVEC4_PER_SB;
            hdr = weight_buf.w4[b4];
            // No Q5_K `qh` são os uvec4 1..2 (os 32 bytes do 5º bit) e `qs` começa no 3.
            uint qs0 = TIPO == Q5K ? 3u : 1u;
            qs = weight_buf.w4[b4 + qs0 + (j >> 1u) * 2u + (w_alta ? 1u : 0u)];
            if (TIPO == Q5K) {
                qh = weight_buf.w4[b4 + 1u + (w_alta ? 1u : 0u)];
            }
        }
    }
    if (x_col < BN) {
        xq = xq_buf.xq[(coluna(col0, x_col) * n_blk + blk) * 8u + x_u];
    }
    if (t < BN) {
        uint cb = coluna(col0, t) * n_blk + blk;
        xd = xd_buf.xd[cb];
        // O Q6_K e o Q3_K não têm termo de mínimo: a soma dos int8 da ativação não entra.
        if (!DUAS_ESCALAS) {
            for (uint u = 0u; u < 8u; u++) { xs[u] = xq_buf.xq[cb * 8u + u]; }
        }
    }
}

// Os 4 pesos de 6 bits do Q6_K menos 32, em int8 com sinal, sem borrow entre bytes: com o
// bit 7 de cada byte ligado a subtração não empresta do vizinho, e o xor final desfaz o
// bit — para b em 0..63, (b | 0x80) - 0x20 fica em 96..159, e o xor dá b - 32 mod 256.
uint menos32(uint v) {
    return ((v | 0x80808080u) - 0x20202020u) ^ 0x80808080u;
}

// O mesmo truque para os 3 bits do Q3_K: u em 0..7 vira u - 4 em int8.
uint menos4(uint v) {
    return ((v | 0x80808080u) - 0x04040404u) ^ 0x80808080u;
}

// Byte `i` (0..11) das escalas do Q3_K, nos .xyz do uvec4 6.
uint byte_q3(uvec4 v, uint i) {
    uint w = i < 4u ? v.x : (i < 8u ? v.y : v.z);
    return (w >> (8u * (i & 3u))) & 0xFFu;
}

// Escala `is` (0..15) do Q3_K, já sem o offset de 32.
int escala_q3(uvec4 sc, uint is) {
    uint lo = is < 8u ? (byte_q3(sc, is) & 0xFu) : (byte_q3(sc, is - 8u) >> 4u);
    uint hi = (byte_q3(sc, 8u + (is & 3u)) >> (2u * (is >> 2u))) & 3u;
    return int(lo | (hi << 4u)) - 32;
}

void main() {
    uint t = gl_LocalInvocationID.x;
    uint linha0 = gl_WorkGroupID.x * BM;
    uint col0 = gl_WorkGroupID.y * BN;   // primeira coluna (token) do tile

    if (TIPO == IQ3) {
        grade[t] = IQ3XXS_GRID[t];
    }
    // MoE: tile, expert e as colunas que ele cobre. Tiles além do total saem inteiros (o
    // host despacha o teto, `max_tiles`), antes de qualquer barreira.
    uint n_cols = BN;
    if (MOE == 1u) {
        uint tile = gl_WorkGroupID.y;
        if (tile >= mapa.m[0]) { return; }
        uint d = 2u + 3u * tile;
        uint expert = mapa.m[d];
        uint inicio = mapa.m[d + 1u];
        n_cols = mapa.m[d + 2u];
        base_linha = expert * pc.n_out;
        col0 = 0u;
        if (t < BN) {
            // Colunas além do tile repetem a primeira: carga válida, resultado descartado.
            uint s = mapa.m[mapa.m[1] + inicio + min(t, n_cols - 1u)];
            slot_de[t] = s;
            xcol_de[t] = pc.tem_bias != 0u ? s : s / pc.row_offset;
        }
    }
    barrier();

    uint n_sb = pc.n_in / 256u;
    // Tamanho da linha de peso: em uvec4 (Q4_K/Q5_K) ou em uints (Q6_K).
    uint linha4 = n_sb * (TIPO == Q6K ? UINTS_PER_SB_Q6K
                       : (TIPO == Q80 ? UINTS_PER_SB_Q80 : UVEC4_PER_SB));
    uint n_blk = pc.n_in / 32u;          // blocos de ativacao por coluna

    // Carga do tile de peso: duas threads por linha, uma para cada metade dos 32 elementos.
    uint w_linha = t >> 1u;
    bool w_alta = (t & 1u) != 0u;
    // Carga do tile de ativacao: uma thread por (coluna, uint). BN <= 32 garante
    // BN * 8 <= 256, entao cabe numa passada.
    uint x_col = t >> 3u;
    uint x_u = t & 7u;

    // Grade de calculo: 32 grupos de linha x 8 de coluna.
    uint ti = t >> 3u;
    uint tj = t & 7u;

    float acc[TM * TN];
    for (uint i = 0u; i < TM * TN; i++) { acc[i] = 0.0; }

    // Buffer duplo em registrador: os loads globais do passo k+1 saem logo depois da barreira
    // do passo k e chegam enquanto as contas dele rodam. Sem isso cada passo de K esperava a
    // latência inteira da memória com a GPU quase parada (~2 workgroups por CU).
    uint lg = linha0 + w_linha;
    uvec4 r_hdr = uvec4(0u);
    uvec4 r_qs = uvec4(0u);
    uvec4 r_qh = uvec4(0u);
    int r_xq = 0;
    float r_xd = 0.0;
    int r_xs[8];
    for (uint u = 0u; u < 8u; u++) { r_xs[u] = 0; }
    buscar(0u, lg, linha4, n_blk, w_alta, x_col, x_u, t, col0, r_hdr, r_qs, r_qh, r_xq, r_xd,
           r_xs);

    for (uint k0 = 0u; k0 < pc.n_in; k0 += BK) {
        uint j = (k0 >> 5u) & 7u;    // sub-bloco de 32 dentro do superbloco

        // Fecha as leituras do passo anterior antes de sobrescrever a LDS.
        barrier();

        uint dst = w_linha * LDS_PASSO + (w_alta ? 4u : 0u);
        if (lg < pc.n_out && TIPO == Q6K) {
            // Quarto j%4 do layout: nibble alto de `ql` nos quartos 2 e 3, e o par de bits
            // de `qh` deslocado de 2*(j%4).
            uint quarto = j & 3u;
            bool hi = quarto >= 2u;
            uint sh = quarto * 2u;
            for (uint u = 0u; u < 4u; u++) {
                uint v = ((hi ? (r_qs[u] >> 4u) : r_qs[u]) & 0x0F0F0F0Fu)
                       | (((r_qh[u] >> sh) & 0x03030303u) << 4u);
                lw[dst + u] = menos32(v);
            }
            uint sub = 2u * j + (w_alta ? 1u : 0u);
            float ds = unpackHalf2x16(r_hdr.x).x
                     * float(int(((r_hdr.y >> (8u * (sub & 3u))) & 0xFFu) << 24u) >> 24);
            if (w_alta) { lwsc2[w_linha] = ds; } else { lwsc[w_linha] = ds; }
        } else if (lg < pc.n_out && TIPO == IQ3) {
            // As duas palavras de 8 elementos desta metade: grade com o sinal aplicado. Toda
            // magnitude da grade é ≥ 4, então negar byte a byte (xor + 1) não carrega.
            uint aux = r_hdr.x;
            for (uint li = 0u; li < 2u; li++) {
                uint l = (w_alta ? 2u : 0u) + li;
                uint s7 = (aux >> (7u * l)) & 127u;
                uint sinais = s7 | ((bitCount(s7) & 1u) << 7u);
                uint g1 = grade[(r_qs.x >> (16u * li)) & 0xFFu];
                uint g2 = grade[(r_qs.x >> (16u * li + 8u)) & 0xFFu];
                uint m1 = mascara_neg(sinais & 0xFu);
                uint m2 = mascara_neg(sinais >> 4u);
                lw[dst + 2u * li] = (g1 ^ m1) + (m1 & 0x01010101u);
                lw[dst + 2u * li + 1u] = (g2 ^ m2) + (m2 & 0x01010101u);
            }
            float db = unpackHalf2x16(r_hdr.y).x * (0.5 + float(aux >> 28u)) * 0.5;
            if (w_alta) { lwsc2[w_linha] = db; } else { lwsc[w_linha] = db; }
        } else if (lg < pc.n_out && TIPO == Q80) {
            for (uint u = 0u; u < 4u; u++) { lw[dst + u] = r_qs[u]; }
            float ds = unpackHalf2x16(r_hdr.x).x;
            if (w_alta) { lwsc2[w_linha] = ds; } else { lwsc[w_linha] = ds; }
        } else if (lg < pc.n_out && TIPO == Q3K) {
            uint sh_q = 2u * (j & 3u);
            uint sh_h = j;   // bit 4 * (j / 4) + j % 4 de hmask = bit j
            for (uint u = 0u; u < 4u; u++) {
                uint v = ((r_qs[u] >> sh_q) & 0x03030303u) | (((r_qh[u] >> sh_h) & 0x01010101u) << 2u);
                lw[dst + u] = menos4(v);
            }
            uint sub = 2u * j + (w_alta ? 1u : 0u);
            float ds = unpackHalf2x16(r_hdr.w).x * float(escala_q3(r_hdr, sub));
            if (w_alta) { lwsc2[w_linha] = ds; } else { lwsc[w_linha] = ds; }
        } else if (lg < pc.n_out) {
            bool hi = (j & 1u) != 0u;
            for (uint u = 0u; u < 4u; u++) {
                uint v = wpack(r_qs[u], hi);
                if (TIPO == Q5K) {
                    // O 5º bit do elemento i do sub-bloco j é o bit j do byte i de `qh`.
                    v |= ((r_qh[u] >> j) & 0x01010101u) << 4u;
                }
                lw[dst + u] = v;
            }
            if (!w_alta) {
                vec2 dm = unpackHalf2x16(r_hdr.x);   // .x = d, .y = dmin
                uint sc, m;
                scale_min(r_hdr, j, sc, m);
                lwsc[w_linha] = dm.x * float(sc);
                lwoff[w_linha] = -dm.y * float(m);
            }
        } else if (!w_alta) {
            // Linha fora da matriz: zera a escala para o resultado dela ser inofensivo.
            lwsc[w_linha] = 0.0;
            lwsc2[w_linha] = 0.0;
            lwoff[w_linha] = 0.0;
        }
        if (x_col < BN) {
            lx[x_col * LDS_PASSO + x_u] = r_xq;
        }
        if (t < BN) {
            lxd[t] = r_xd;
            // Soma dos int8 do bloco, para o termo do `dmin`. So depende da coluna.
            int isx = 0;
            if (!DUAS_ESCALAS) {
                for (uint u = 0u; u < 8u; u++) {
                    isx = dotPacked4x8AccSatEXT(0x01010101, r_xs[u], isx);
                }
            }
            lxs[t] = float(isx);
        }

        barrier();

        if (k0 + BK < pc.n_in) {
            buscar(k0 + BK, lg, linha4, n_blk, w_alta, x_col, x_u, t, col0, r_hdr, r_qs, r_qh,
                   r_xq, r_xd, r_xs);
        }

        // As colunas desta thread saem da LDS uma vez e servem as TM linhas.
        int xr[TN * 8u];
        float xd_c[TN];
        float xs_c[TN];
        for (uint c = 0u; c < TN; c++) {
            uint col = tj * TN + c;
            for (uint u = 0u; u < 8u; u++) { xr[c * 8u + u] = lx[col * LDS_PASSO + u]; }
            xd_c[c] = lxd[col];
            xs_c[c] = lxs[col];
        }

        for (uint r = 0u; r < TM; r++) {
            // Linhas intercaladas (ti, ti+32, ...): com passo 9, as 8 linhas distintas de uma
            // wave caem em 8 bancos distintos.
            uint rr = r * LINHA_GRUPOS + ti;
            float sc = lwsc[rr];
            float off = lwoff[rr];
            float sc2 = DUAS_ESCALAS ? lwsc2[rr] : 0.0;
            int w[8];
            for (uint u = 0u; u < 8u; u++) { w[u] = int(lw[rr * LDS_PASSO + u]); }
            for (uint c = 0u; c < TN; c++) {
                if (DUAS_ESCALAS) {
                    // Duas metades de 16, cada uma com a sua escala.
                    int i0 = 0;
                    int i1 = 0;
                    for (uint u = 0u; u < 4u; u++) {
                        i0 = dotPacked4x8AccSatEXT(w[u], xr[c * 8u + u], i0);
                        i1 = dotPacked4x8AccSatEXT(w[u + 4u], xr[c * 8u + u + 4u], i1);
                    }
                    acc[r * TN + c] += xd_c[c] * (sc * float(i0) + sc2 * float(i1));
                } else {
                    int isum = 0;
                    for (uint u = 0u; u < 8u; u++) {
                        isum = dotPacked4x8AccSatEXT(w[u], xr[c * 8u + u], isum);
                    }
                    acc[r * TN + c] += xd_c[c] * (sc * float(isum) + off * xs_c[c]);
                }
            }
        }
    }

    for (uint r = 0u; r < TM; r++) {
        uint rr = linha0 + r * LINHA_GRUPOS + ti;
        if (rr >= pc.n_out) { continue; }
        if (MOE == 1u) {
            for (uint c = 0u; c < TN; c++) {
                uint cl = tj * TN + c;
                if (cl < n_cols) {
                    out_buf.y[slot_de[cl] * pc.n_out + rr] = acc[r * TN + c];
                }
            }
            continue;
        }
        float bias = pc.tem_bias != 0u ? bias_buf.b[rr] : 0.0;
        for (uint c = 0u; c < TN; c++) {
            out_buf.y[(col0 + tj * TN + c) * pc.n_out + rr] = acc[r * TN + c] + bias;
        }
    }
}
