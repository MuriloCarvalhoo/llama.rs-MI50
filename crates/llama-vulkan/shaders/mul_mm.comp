#version 450
#extension GL_EXT_integer_dot_product : require

// GEMM Q4_K com tiling em LDS: `Y[n_out x COLS] = W[n_out x n_in] * X[n_in x COLS]`.
//
// Padrao do prefill desde 2026-08-22 (`LLAMA_RS_PREFILL_GEMM=0` desliga) — ver
// `docs/prefill-em-batch.md`.
//
// ## Por que um GEMM, e por que so no prefill
//
// O matvec de N colunas (`q4_k_matvec.comp` com `COLS=N`) le o peso da VRAM uma vez para
// as N ativacoes, mas cada lane guarda `ROWS_PER_WAVE * COLS` acumuladores: subir N
// derruba a ocupancia, e em algum ponto isso custa mais do que o reuso rende. O GEMM troca
// o reuso em registrador pelo reuso em LDS — o tile de peso e lido uma vez da VRAM,
// escrito em LDS e consumido por todas as colunas do tile, com cada thread guardando
// TM x TN acumuladores em vez de ROWS x COLS.
//
// No decode isso nao serve para nada: com uma coluna o kernel e limitado por banda e o
// tile em LDS e custo puro. E o prefill que passa a ser compute-bound, e ai a MI50 tem
// folga — ~52 TOPS de int8 (`V_DOT4_I32_I8`) contra 717 GB/s.
//
// ## Geometria
//
// Workgroup de 256 threads (4 waves), tile **BM=128 linhas x BN=min(COLS, 32) colunas x
// BK=32**; blocos maiores que 32 viram `COLS/32` tiles de coluna em `gl_WorkGroupID.y`.
// As 256 threads sao uma grade 32 x 8: cada uma calcula TM=4 linhas por TN=BN/8 colunas.
// Por passo de K, a thread le TM*8 uints de peso e TN*8 de ativacao da LDS e faz TM*TN*8
// dots — intensidade TM*TN/(TM+TN) = 2 com COLS=32, que e o ponto do exercicio.
//
// Duas correcoes de 2026-09-25, medidas na bancada (`bancada.rs`, `bancada_mul_mm`):
// - **bancos da LDS**: com passo 8 e linhas contiguas por thread (ti*TM + r), as linhas que
//   uma wave le juntas ficavam a 32 palavras umas das outras, todas no mesmo banco; com
//   COLS=32 as colunas tambem (tj*4*8). Passo 9 (`LDS_PASSO`) e linhas intercaladas
//   (r*32 + ti) espalham os dois. Era por isso que o bloco 32 perdia para o 24.
// - **buffer duplo em registrador**: os loads globais do passo k+1 saem antes das contas do
//   passo k (`buscar`). Com ~2 workgroups por CU, sem isso cada passo esperava a latencia
//   inteira da memoria.
// Juntas: 7,3 -> 10,1 TOPS no ffn_gate (5120->17408) com COLS=32, e o bloco 32 passou a valer.
//
// BK=32 nao e escolha livre: e o sub-bloco de quantizacao do Q4_K **e** o bloco do
// `quantize_x`, entao cada passo de K tem exatamente uma escala de peso e uma de ativacao.
//
// ## Formato
//
// Q4_K, Q5_K e Q6_K, pela constante `TIPO` (ver abaixo); o plano escolhe por tipo de peso.
// Em produção o Q4_K vai por `mul_mm_q4k.comp`, com passo de K = 64 (16-70% mais rápido na
// bancada); o `TIPO = 0` daqui fica como a base de que o Q5_K deriva.
// Os layouts de superbloco sao os de `q4_k_matvec.comp`, `q5_k_matvec.comp` e
// `q6_k_matvec.comp`, que documentam a extracao de escala e minimo de 6 bits.
//
// O termo afim do Q4_K (`- dmin * m * soma(x)`) sobrevive ao tiling porque `soma(x)` so
// depende da coluna: e calculada uma vez por (coluna, passo de K) e guardada na LDS junto
// com a escala da ativacao.

layout(local_size_x = 256) in;
// Colunas = tokens do bloco de prefill. Ate 32, multiplo de 8 (a grade de threads tem 8
// grupos de coluna); acima disso, multiplo de 32 (um tile de 32 por `gl_WorkGroupID.y`).
layout(constant_id = 0) const uint COLS = 32u;
// Tipo do peso: 0 = Q4_K, 1 = Q5_K, 2 = Q6_K, 3 = Q3_K, 4 = Q8_0. Os três últimos vão pelo
// caminho de int8 com sinal e duas escalas de 16 por passo, sem mínimo (no Q8_0 as duas são
// a mesma) — ver `q3_k_matvec.comp` e `q8_0_matvec.comp` para os layouts. Só a carga e o desempacotamento do tile de
// peso mudam — na LDS os três viram int8 com escala por sub-bloco, e o laço de conta é o
// mesmo (o Q6_K com duas escalas por passo de K, porque o sub-bloco dele tem 16 elementos,
// e sem termo de mínimo: o -32 já sai no desempacotamento).
layout(constant_id = 1) const uint TIPO = 0u;
const uint Q4K = 0u;
const uint Q5K = 1u;
const uint Q6K = 2u;
const uint Q3K = 3u;
const uint Q80 = 4u;
// IQ3_XXS (só nos experts): o layout reempacotado de `moe_matvec.comp`, com o sinal aplicado
// no desempacotamento e uma escala por bloco de 32 (as duas metades com a mesma).
const uint IQ3 = 5u;
// Q6_K, Q3_K, Q8_0 e IQ3_XXS: escala por metade de 16 e nenhum termo de mínimo.
const bool DUAS_ESCALAS = TIPO == Q6K || TIPO == Q3K || TIPO == Q80 || TIPO == IQ3;
// 1 = GEMM dos experts de um MoE. Cada workgroup em Y é um tile da lista que o
// `moe_contar.comp` montou: um expert e até BN slots (token, k) que o escolheram. O peso do
// expert sai da memória uma vez para todos eles — é o `mul_mm_id` do llama.cpp. O binding 4
// vira o mapa de tiles, e os dois últimos campos do push viram `n_usados` e `x_por_slot`.
layout(constant_id = 2) const uint MOE = 0u;

const uint BM = 128u;          // linhas de saida por workgroup
const uint BK = 32u;           // elementos de K por passo — o sub-bloco do Q4_K
const uint THREADS = 256u;
const uint COL_GRUPOS = 8u;
const uint LINHA_GRUPOS = THREADS / COL_GRUPOS;  // 32
const uint TM = BM / LINHA_GRUPOS;               // 4 linhas por thread
// Colunas por tile: o bloco inteiro até 32, e fatias de 32 acima disso, uma por
// `gl_WorkGroupID.y` — como os tiles de `J` colunas do MMQ do llama.cpp. Acima de 32 as
// colunas deixariam de caber numa passada de carga (8 uints cada, 256 threads) e TN passaria
// de 4 acumuladores por linha; fatiar mantém o tile e multiplica os workgroups, que é o que
// faltava (136 workgroups para 60 CUs no ffn_gate com o bloco de 32).
const uint BN = COLS < 32u ? COLS : 32u;
const uint TN = BN / COL_GRUPOS;                 // colunas por thread
// Passo das linhas (peso) e colunas (ativacao) na LDS: 9 uints, nao 8. Com 8, as linhas que
// as threads de uma wave leem juntas ficavam a 32 palavras umas das outras — todas no mesmo
// banco, leitura 8x serializada. 9 e coprimo com os 32 bancos.
const uint LDS_PASSO = 9u;

layout(set = 0, binding = 0) readonly buffer WeightBuf { uvec4 w4[]; } weight_buf;
// O mesmo buffer lido de 4 em 4 bytes: o superbloco Q6_K sobe alinhado em 212 bytes (53
// uints), que não é múltiplo de 16.
layout(set = 0, binding = 0) readonly buffer WeightBufU { uint w[]; } weight_u;
// Ativacao quantizada: 8 ints por bloco de 32 (4 i8 empacotados cada).
layout(set = 0, binding = 1) readonly buffer XqBuf { int xq[]; } xq_buf;
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;
layout(set = 0, binding = 4) readonly buffer BiasBuf { float b[]; } bias_buf;
layout(set = 0, binding = 4) readonly buffer MapaBuf { uint m[]; } mapa;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint row_offset;  // vestigial (saida indexada por linha absoluta)
    uint tem_bias;
} pc;

// uvec4 por superbloco: 144 bytes no Q4_K, 176 no Q5_K. O Q6_K conta em uints.
const uint UVEC4_PER_SB = TIPO == Q5K ? 11u : ((TIPO == Q3K || TIPO == IQ3) ? 7u : 9u);
const uint UINTS_PER_SB_Q6K = 53u;
// Q8_0 sobe como 8 blocos de 36 bytes (escala f16 | pad | 32 int8) por 256 elementos.
const uint UINTS_PER_SB_Q80 = 72u;

// Tile de peso: BM linhas x 32 int8, empacotados 4 por uint.
shared uint lw[BM * LDS_PASSO];
shared float lwsc[BM];    // d * sc do sub-bloco (no Q6_K, da primeira metade de 16)
shared float lwsc2[BM];   // Q6_K: d * sc da segunda metade de 16
shared float lwoff[BM];   // -dmin * m do sub-bloco (Q4_K/Q5_K)
// Tile de ativacao: BN colunas x 32 int8, mais escala e soma dos int8 por coluna.
shared int lx[BN * LDS_PASSO];
// MoE: o slot de cada coluna do tile e a coluna da ativação que ele lê.
shared uint slot_de[32];
shared uint xcol_de[32];
// IQ3_XXS: a grade de magnitudes, copiada para a LDS no início.
shared uint grade[256];

