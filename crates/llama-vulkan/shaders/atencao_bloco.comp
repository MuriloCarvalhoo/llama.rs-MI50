#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_clustered : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 256) in;

// Atenção do bloco de prefill: um workgroup cobre **uma cabeça de KV, TT tokens e uma fatia
// do KV**, e as 64 linhas de query (TT tokens × n_rep cabeças do grupo GQA) dividem cada
// tile de K e V carregado uma vez na LDS. Inspirado no `flash_attn.comp` escalar do
// llama.cpp (D_split, row_split), com o tile por thread levado ao limite do gfx906.
//
// **Por thread, a cada passo de 32 posições: 2 linhas × 16 posições × 64 dimensões = 2048
// FMA no Q·K e 2048 no P·V.** O desenho anterior fazia 2 × 1 × 16 = 32 FMA por passo e
// pagava 8 shuffles por posição para somar o produto escalar entre 16 lanes; o llama.cpp
// faz 4 × 4 × 32 = 512. Aqui são 4 lanes por posição (`subgroupClusteredAdd` de 4, que no
// GCN é DPP dentro do quad), então a soma custa 2 operações por score, ~3% da conta.
//
// `C` (posições por thread) medido em 2026-11-21 a 16k, bloco de 256, 35B: C=32 (4096 FMA,
// o teto: 256 VGPR, sem spill, 60 KB de código) 19,0 ms; C=16 15,8; C=8 17,1; C=4 19,9;
// o kernel anterior 18,6. Nenhum passa de ~30% do pico: a LDS leva o Q em f16 (64 linhas ×
// 512 B = 32 KB) e o tile, então cabe um workgroup por CU — uma wave por SIMD, sem outra
// para cobrir a latência da LDS e das barreiras. Sem a carga global o C=16 cai só para 13,1.
//
// Layout da wave (64 lanes): dl = lane & 3 divide a dimensão (bloco de 8 dims `i*4 + dl`,
// para as 4 lanes lerem 64 B contíguos da LDS), cl = (lane >> 2) & 1 divide as posições
// (posição `j*2 + cl`), e as 8 lanes restantes são grupos de linhas.
//
// Cada `cl` mantém o seu próprio softmax online (m, l, acc) — sem redução entre lanes a cada
// passo — e os dois são combinados uma vez no fim. Saída: o registro parcial
// [m, l, acc[head_dim]] por (t, h, fatia), sem dividir por l; o `attn_reduce.comp` combina
// as fatias.
//
// Exige head_dim = 256 e n_rep par (as duas linhas de uma thread são do mesmo token). O
// plano cai no split16 fora disso.

layout(set = 0, binding = 0) readonly buffer QBuf { float q[]; } qb;
layout(set = 0, binding = 1) readonly buffer KBuf { uvec4 k4[]; } kb;
layout(set = 0, binding = 2) readonly buffer VBuf { uvec4 v4[]; } vb;
layout(set = 0, binding = 3) writeonly buffer PBuf { float p[]; } pbuf;

layout(push_constant) uniform PC {
    uint n_head; uint n_head_kv; uint head_dim;
    uint total_len; uint kv_dim; uint kv_layer_off;
    uint q_stride;
} pc;

const uint HD = 256u;
const uint UV_POS = HD / 8u;      // uvec4 (8 f16) por posição: 32
const uint DL = 4u;               // lanes que dividem uma posição
const uint CL = 2u;               // lanes que dividem as posições do tile
const uint C = 16u;               // posições por thread por passo
const uint BC = CL * C;           // posições do tile: 32
const uint CH = UV_POS / DL;      // blocos de 8 dims por thread: 8 (64 dims)
const uint LINHAS = 64u;          // linhas de query por workgroup (32 grupos × 2)

shared uvec4 qs[LINHAS * UV_POS];  // Q em f16, já escalado: 32 KB
shared uvec4 kv[BC * UV_POS];      // tile de K, depois de V: 16 KB

// s += dot(k[8 f16], q[8 f32]); `unpackHalf2x16` + `fma` vira `v_fma_mix_f32` no ACO.
float dot8(uvec4 k, float qf[8], float s) {
    vec2 x;
    x = unpackHalf2x16(k.x); s = fma(x.x, qf[0], s); s = fma(x.y, qf[1], s);
    x = unpackHalf2x16(k.y); s = fma(x.x, qf[2], s); s = fma(x.y, qf[3], s);
    x = unpackHalf2x16(k.z); s = fma(x.x, qf[4], s); s = fma(x.y, qf[5], s);
    x = unpackHalf2x16(k.w); s = fma(x.x, qf[6], s); s = fma(x.y, qf[7], s);
    return s;
}

void unpack8(uvec4 w, out float f[8]) {
    vec2 x;
    x = unpackHalf2x16(w.x); f[0] = x.x; f[1] = x.y;
    x = unpackHalf2x16(w.y); f[2] = x.x; f[3] = x.y;
    x = unpackHalf2x16(w.z); f[4] = x.x; f[5] = x.y;
    x = unpackHalf2x16(w.w); f[6] = x.x; f[7] = x.y;
}

void carrega_tile(bool eh_k, uint c0, uint fim, uint kv_h, uint tid) {
    // BC posições × 32 uvec4, 512 B contíguos por posição.
    for (uint u = tid; u < BC * UV_POS; u += 256u) {
        uint j = c0 + u / UV_POS;
        uvec4 w = uvec4(0u);
        if (j < fim) {
            uint base4 = (pc.kv_layer_off + j * pc.kv_dim + kv_h * HD) >> 3u;
            w = eh_k ? kb.k4[base4 + (u % UV_POS)] : vb.v4[base4 + (u % UV_POS)];
        }
        kv[u] = w;
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint kv_h = gl_WorkGroupID.x;
    uint tile = gl_WorkGroupID.y;
    uint split = gl_WorkGroupID.z;
    uint n_split = gl_NumWorkGroups.z;
    uint n_rep = pc.n_head / pc.n_head_kv;
    uint tt = LINHAS / n_rep;                 // tokens por workgroup
    // O host só usa este kernel com o bloco múltiplo de `tt` (ver `atencao_bloco_serve`),
    // então o grid dá o tamanho do bloco.
    uint n_tok = gl_NumWorkGroups.y * tt;
    uint linhas_ativas = tt * n_rep;

    uint dl = tid & 3u;
    uint cl = (tid >> 2u) & 1u;
    uint r0 = (tid >> 3u) * 2u;
    uint t_loc = r0 / n_rep;
    uint hl = r0 % n_rep;                      // primeira das duas cabeças locais
    uint t = tile * tt + t_loc;
    bool ativa = r0 < linhas_ativas;
    uint h0 = kv_h * n_rep + hl;

    // Máscara causal: o bloco termina em total_len, e o token t vê as posições
    // 0 .. total_len - (n_tok - 1) + t.
    uint limite = ativa ? (pc.total_len - (n_tok - 1u) + t) : 0u;
    uint ultimo = tile * tt + tt - 1u;
    uint alcance = pc.total_len - (n_tok - 1u) + ultimo;   // limite do último token do tile

    uint por_split = (alcance + n_split - 1u) / n_split;
    uint ini = split * por_split;
    uint fim = min(ini + por_split, alcance);

    // Q das 64 linhas para a LDS, em f16 e já multiplicado pela escala.
    float scale = inversesqrt(float(HD));
    for (uint u = tid; u < LINHAS * UV_POS; u += 256u) {
        uint row = u / UV_POS;
        uvec4 w = uvec4(0u);
        if (row < linhas_ativas) {
            uint rt = tile * tt + row / n_rep;
            uint rh = kv_h * n_rep + row % n_rep;
            uint b = rt * pc.n_head * pc.q_stride + rh * pc.q_stride + (u % UV_POS) * 8u;
            w = uvec4(
                packHalf2x16(vec2(qb.q[b], qb.q[b + 1u]) * scale),
                packHalf2x16(vec2(qb.q[b + 2u], qb.q[b + 3u]) * scale),
                packHalf2x16(vec2(qb.q[b + 4u], qb.q[b + 5u]) * scale),
                packHalf2x16(vec2(qb.q[b + 6u], qb.q[b + 7u]) * scale));
        }
        qs[u] = w;
    }

    float o0[CH * 8u];
    float o1[CH * 8u];
    [[unroll]] for (uint i = 0u; i < CH * 8u; i++) { o0[i] = 0.0; o1[i] = 0.0; }
    float m0 = -1.0e30;
    float m1 = -1.0e30;
    float l0 = 0.0;
    float l1 = 0.0;

    for (uint c0 = ini; c0 < fim; c0 += BC) {
        barrier();   // o P·V do passo anterior terminou de ler o tile
        carrega_tile(true, c0, fim, kv_h, tid);
        barrier();

        // S = Q·K: 2 linhas × C posições, cada thread com 64 das 256 dimensões.
        float s0[C];
        float s1[C];
        [[unroll]] for (uint j = 0u; j < C; j++) { s0[j] = 0.0; s1[j] = 0.0; }
        [[dont_unroll]] for (uint i = 0u; i < CH; i++) {
            uint cc = i * DL + dl;
            float qa[8];
            float qz[8];
            unpack8(qs[r0 * UV_POS + cc], qa);
            unpack8(qs[(r0 + 1u) * UV_POS + cc], qz);
            [[unroll]] for (uint j = 0u; j < C; j++) {
                uvec4 k = kv[(j * CL + cl) * UV_POS + cc];
                s0[j] = dot8(k, qa, s0[j]);
                s1[j] = dot8(k, qz, s1[j]);
            }
        }

        // Soma entre as 4 lanes da posição, máscara e softmax online deste `cl`.
        float mx0 = -1.0e30;
        float mx1 = -1.0e30;
        [[unroll]] for (uint j = 0u; j < C; j++) {
            float x0 = subgroupClusteredAdd(s0[j], DL);
            float x1 = subgroupClusteredAdd(s1[j], DL);
            uint pos = c0 + j * CL + cl;
            bool ok = pos < fim && pos < limite;
            s0[j] = ok ? x0 : -1.0e30;
            s1[j] = ok ? x1 : -1.0e30;
            mx0 = max(mx0, s0[j]);
            mx1 = max(mx1, s1[j]);
        }
        float mn0 = max(m0, mx0);
        float mn1 = max(m1, mx1);
        float c0r = exp(m0 - mn0);
        float c1r = exp(m1 - mn1);
        l0 *= c0r;
        l1 *= c1r;
        [[unroll]] for (uint i = 0u; i < CH * 8u; i++) { o0[i] *= c0r; o1[i] *= c1r; }
        [[unroll]] for (uint j = 0u; j < C; j++) {
            // Mascarada: peso zero explícito (exp(-1e30 - m) com m = -1e30 daria 1).
            s0[j] = s0[j] > -1.0e29 ? exp(s0[j] - mn0) : 0.0;
            s1[j] = s1[j] > -1.0e29 ? exp(s1[j] - mn1) : 0.0;
            l0 += s0[j];
            l1 += s1[j];
        }
        m0 = mn0;
        m1 = mn1;

        barrier();   // todo mundo terminou de ler K
        carrega_tile(false, c0, fim, kv_h, tid);
        barrier();

        // O += P·V nas 64 dimensões desta thread.
        [[unroll]] for (uint i = 0u; i < CH; i++) {
            uint cc = i * DL + dl;
            [[unroll]] for (uint j = 0u; j < C; j++) {
                float v[8];
                unpack8(kv[(j * CL + cl) * UV_POS + cc], v);
                [[unroll]] for (uint e = 0u; e < 8u; e++) {
                    o0[i * 8u + e] = fma(s0[j], v[e], o0[i * 8u + e]);
                    o1[i * 8u + e] = fma(s1[j], v[e], o1[i * 8u + e]);
                }
            }
        }
    }

    // Junta os dois `cl` (lanes a distância 4): mesmo token, mesmas linhas, posições
    // disjuntas.
    float m0o = subgroupShuffleXor(m0, 4u);
    float m1o = subgroupShuffleXor(m1, 4u);
    float l0o = subgroupShuffleXor(l0, 4u);
    float l1o = subgroupShuffleXor(l1, 4u);
    float mt0 = max(m0, m0o);
    float mt1 = max(m1, m1o);
    float a0 = exp(m0 - mt0);
    float b0 = exp(m0o - mt0);
    float a1 = exp(m1 - mt1);
    float b1 = exp(m1o - mt1);
    [[unroll]] for (uint i = 0u; i < CH * 8u; i++) {
        o0[i] = o0[i] * a0 + subgroupShuffleXor(o0[i], 4u) * b0;
        o1[i] = o1[i] * a1 + subgroupShuffleXor(o1[i], 4u) * b1;
    }
    l0 = l0 * a0 + l0o * b0;
    l1 = l1 * a1 + l1o * b1;

    if (!ativa || cl != 0u) { return; }
    uint reg0 = ((t * pc.n_head + h0) * n_split + split) * (HD + 2u);
    uint reg1 = ((t * pc.n_head + h0 + 1u) * n_split + split) * (HD + 2u);
    if (dl == 0u) {
        pbuf.p[reg0] = mt0;
        pbuf.p[reg0 + 1u] = l0;
        pbuf.p[reg1] = mt1;
        pbuf.p[reg1 + 1u] = l1;
    }
    [[unroll]] for (uint i = 0u; i < CH; i++) {
        uint d0 = (i * DL + dl) * 8u;
        [[unroll]] for (uint e = 0u; e < 8u; e++) {
            pbuf.p[reg0 + 2u + d0 + e] = o0[i * 8u + e];
            pbuf.p[reg1 + 2u + d0 + e] = o1[i * 8u + e];
        }
    }
}
